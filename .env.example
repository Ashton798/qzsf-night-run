# 复制为 .env 后修改（.env 已被 .gitignore 排除，不会提交）
PORT=8777
HOST=0.0.0.0
DB_PATH=data/qzsf.db

# 首次启动自动创建的管理员（仅当数据库中还没有管理员时生效）
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe_2025!

# 跨域部署时填写前端域名，同源部署留空
ALLOWED_ORIGIN=

# ---------------------------------------------------------------------------
# 高德地图（JavaScript API 2.0）
# ---------------------------------------------------------------------------
# 申请地址：https://console.amap.com/dev/key/app
#   「创建新应用」→「添加 Key」→ 服务平台选择 Web端(JS API)
#   创建成功后会同时给出 Key 和「安全密钥 Security JS Code」，两者必须配套。
#
# AMAP_WEB_KEY：会下发给浏览器（这是 JS API 的固有设计），
#   因此必须在高德控制台配置「域名白名单」，只允许你的正式域名。
# AMAP_SECURITY_JS_CODE：只由服务端代理使用，永远不会出现在前端代码或接口响应里。
AMAP_WEB_KEY=your_js_api_key_here
AMAP_SECURITY_JS_CODE=your_security_js_code_here

# 可选：把高德官方代理路径挂到别的路径前缀下（一般留空即可）
# 服务端会自动暴露 /_AMapService/* 代理给 JS API 2.0 使用
# AMAP_SERVICE_PATH=/_AMapService

# 可选：高德 JS API 版本（默认 2.0）
# AMAP_JS_VERSION=2.0
