    "games": [
      {
        "id": "CP1",
        "name": "【飞扬】荧光套圈",
        "rule": "凭夜跑签到凭证卡领取3个荧光圈，在距目标1.5米投掷线后，抛向荧光框内竖立的荧光水瓶。套中1个获得印章；3个均未套中需重新排队挑战。双脚不得越过投掷线。"
      },
      {
        "id": "CP2",
        "name": "【趣投】荧光球入筐",
        "rule": "凭夜跑签到凭证卡领取3个荧光球，在距大号荧光筐1.5米的荧光投掷线后投球。投中1个获得印章；3个均未投中需重新排队挑战。双脚不得越过投掷线。"
      },
      {
        "id": "CP3",
        "name": "【欢乐】荧光猜拳",
        "rule": "竞赛组、体验组凭签到凭证卡与工作人员猜拳，赢1局获得印章，输局可继续挑战、机会不限。",
        "unityRule": "同心组两人共同参与，两人与工作人员各猜一轮，任一人获胜即可获得印章。"
      }
    ],
    "unityRule": "双人参赛，不限性别。除游戏必要时可分开，其余时间手牵手前行。松手违规由现场工作人员记录并交管理员裁定，GPS无法判定牵手。策划书未明确双人计时公式，本系统按一支双人队伍记录共同起终时间，不使用较慢者公式。",
    "conflicts": [
      "同心组签到：流程为18:30–19:30，起点安排为18:40–19:10，待主办方确认。",
